@mastersthesis{vazquez-veloso_evaluacion_2021,
	title = {Evaluación y validación de los modelos de crecimiento forestal {IBEROPT} e {IBEROPS}},
	copyright = {All rights reserved},
	url = {https://uvadoc.uva.es/bitstream/handle/10324/49344/TFM-L531.pdf?sequence=1&isAllowed=n},
	abstract = {La modelización forestal es una herramienta que nos permite no solo predecir cómo evolucionan las masa forestales bajo diferentes escenarios silvícolas, sino también explicar el estado de la masa forestal bajo determinadas condiciones, ayudando a los gestores en el proceso de toma de decisiones. En este campo se han desarrollado ecuaciones para el cálculo de diferentes variables de interés forestal a nivel de árbol, clases de tamaño y masa, cuya precisión en las predicciones es comúnmente evaluada de manera individual. Para el empleo de las mismas, modelos que agrupan ecuaciones y simuladores que facilitan su utilización han sido desarrollados, centralizando la información y facilitando su empleo. No obstante, pese a que la validación de ecuaciones individuales es un campo conocido, la validación conjunta del conjunto de ecuaciones y reglas que componen los modelos es un terreno poco explorado. En este trabajo se dan los primeros pasos para el desarrollo de una metodología de análisis que permita la validación conjunta de modelos. Para ello, se tratan de validar los modelos IBEROPT e IBEROPS desarrollados para Pinus pinaster mesogeensis y Pinus sylvestris, respectivamente, utilizado los datos del Inventario Forestal Nacional (IFN) y la plataforma SIMANFOR para su empleo. Los resultados obtenidos demuestran que la metodología desarrollada es adecuada para mejorar la precisión de las ecuaciones de crecimiento, mientras que detecta carencias en las ecuaciones de mortalidad y masa incorporada cuyas estimaciones aún no se han podido mejorar},
	school = {Universidad de Valladolid},
	author = {Vázquez-Veloso, A.},
	year = {2021},
	keywords = {Trabajos académicos, Master's Thesis, Pinus pinaster, Pinus sylvestris, IBERO, evaluación de modelos, SIMANFOR}
}

@phdthesis{vazquez-veloso_alisis_2026,
	type = {{PhD} {Thesis}},
	title = {Análisis de la dinámica forestal en un contexto de cambio},
	doi = {https://doi.org/10.13140/RG.2.2.15148.42885},
	abstract = {Sustainable forest management has evolved to address emerging challenges related to changes in forest stands and their management objectives. This evolution has been accompanied by the development and refinement of tools that support decision-making. Within this context, forest modeling plays a central role by providing the knowledge and mathematical foundations required for such tools, ultimately supporting forest stakeholders. This doctoral thesis addresses specific gaps in forest modeling, Decision Support Systems, and forest management, with findings aimed at improving forest stakeholders’ decision-making. The work is organized into three sections corresponding to these topics and comprises seven chapters. The first section, focused on forest modeling, addresses three topics. We examined the limited performance of existing mortality models by testing alternative algorithms across case studies (Chapter Ia) and assessing how evaluation metrics influence the identification of the best-performing models (Chapter Ib). We also developed new, user-friendly height–diameter models for Spain’s most relevant forest species and conditions (Chapter II). Finally, we analyzed species interactions in a mixed Mediterranean pinewood, evaluating how competition effects vary with thinning intensity, time since the last thinning, neighborhood size, and species identity (Chapter III). Decision Support Systems serve as the bridge between forest modeling and quantitative silviculture. Chapter IV details the updated version of the SIMANFOR forest management simulator and the new functionalities implemented to meet the needs of the quantitative silviculture section. These tools facilitate the transfer of forest modeling outcomes to stakeholders in a more accessible and practical form. Forest management based on quantitative silviculture constitutes the final section of the thesis, where forest modeling outcomes implemented in SIMANFOR were used to explore management scenarios with less practical experience by forest stakeholders. Chapter V evaluates silvicultural guidelines for Quercus pyrenaica, focusing on converting coppice to high forest and sustainably managing irregular stands. Chapter VI analyzes four mixed forest combinations and their pure counterparts under different climate scenarios to assess CO2 stocks and accumulation rates under natural growth. Finally, Chapter VII provides an in-depth study of Pinus sylvestris x Pinus pinaster, examining trade-offs among four ecosystem services across silvicultural alternatives and mixture gradients.},
	language = {en},
	school = {Universidad de Valladolid},
	author = {Vázquez-Veloso, Aitor},
	year = {2026},
	keywords = {Trabajos académicos, PhD Thesis, SIMANFOR, modelización forestal, modelos altura-diámetro, mortalidad, Quercus pyrenaica, masas mixtas, servicios ecosistémicos}
}

